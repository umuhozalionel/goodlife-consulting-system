rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each authenticated user may create their own user-profile,
    // and read/update only their own document.
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read, update: if request.auth != null && request.auth.uid == userId;
      // no delete
    }

    // Each trainee can read and write only their own profile doc
    match /trainees/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // registrations stays fully open (used for onboarding flows)
    match /registrations/{docId} {
      allow write: if true;
      allow read: if true;
    }

    // internships: owners can create and read their own entries;
    // trainers and admins (based on users/<uid>.role) can read all entries;
    // owners and admins can update/delete.
    match /internships/{docId} {
      allow create: if request.auth != null
                    && request.resource.data.owner == request.auth.uid;

      allow read: if request.auth != null && (
                    resource.data.owner == request.auth.uid ||
                    (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ["trainer", "admin"])
                  );

      allow update, delete: if request.auth != null && (
                              request.auth.uid == resource.data.owner ||
                              (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin")
                            );
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}