rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each authenticated user may create their own user‐profile,
    // and read/update only their own document.
    match /users/{userId} {
      allow create: if request.auth != null;
      allow read, update: if request.auth != null
                        && request.auth.uid == userId;
      // no delete
    }

    // Each trainee can read and write only their own profile doc
    match /trainees/{userId} {
      allow read, write: if request.auth != null
                        && request.auth.uid == userId;
    }

    // registrations stays fully open as before
    match /registrations/{docId} {
      allow write: if true;
      allow read:  if true;
    }
  }
}
